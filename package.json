{
  "name": "sdterm",
  "version": "1.0.4",
  "description": "A local terminal workspace: many terminals, one window.",
  "main": "./out/main/index.js",
  "author": {
    "name": "SEM Devs",
    "email": "info@sem-devs.com",
    "url": "https://sem-devs.com"
  },
  "homepage": "https://sem-devs.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/fix-pty-perms.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win --publish never",
    "build:mac": "npm run typecheck && electron-vite build && electron-builder --mac --publish never",
    "build:mac:release": "node scripts/build-mac-release.mjs",
    "build:linux": "npm run typecheck && electron-vite build && electron-builder --linux --publish never",
    "publish:update": "node scripts/publish-update.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "electron-updater": "^6.8.11",
    "js-yaml": "^5.5.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.8.1",
    "systeminformation": "^5.33.19",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "productName": "sdterm",
  "repository": {
    "type": "git",
    "url": "https://github.com/sem-devs/sdterm.git"
  },
  "desktopName": "sdterm.desktop"
}
